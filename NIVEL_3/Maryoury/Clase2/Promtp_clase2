import pandas as pd

df = pd.read_csv('Hoja de cálculo sin título - Data Sales Adidas.csv')

# Clean Total Sales column
def parse_total_sales(val):
    if isinstance(val, str):
        val = val.replace('$', '').replace(' ', '').replace('.', '').replace(',', '.')
    return float(val)

df['Total Sales Clean'] = df['Total Sales'].apply(parse_total_sales)

pivot = pd.pivot_table(
    df, 
    values='Total Sales Clean', 
    index='Region', 
    columns='Retailer', 
    aggfunc='sum', 
    fill_value=0
)

# Add totals
pivot['Total'] = pivot.sum(axis=1)
pivot.loc['Total'] = pivot.sum(axis=0)

# Format as currency
pivot_formatted = pivot.applymap(lambda x: f"${x:,.2f}")
print(pivot_formatted.to_string())



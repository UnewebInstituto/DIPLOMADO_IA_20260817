    {
      "parameters": {
        "jsCode": "const r = $json;\nconst origen = $('Edit Fields').item.json;\nlet datos;\ntry {\n  const txt = r.candidates[0].content.parts.map(p => p.text || '').join('')\n    .replace(/^```json|```$/g, '').trim();\n  datos = JSON.parse(txt);\n  if (!datos.categoria || !datos.urgencia) throw new Error('faltan campos');\n} catch (e) {\n  datos = { categoria: 'Otro', urgencia: 'Media', resumen: 'ERROR DE FORMATO - revisar', monto: null };\n}\n\nconst f = new Date(origen.date);\n\nreturn { json: {\n  ID_Mensaje: origen.id,\n  Fecha: isNaN(f) ? null : f.toISOString().slice(0, 10),\n  Remitente: origen.From,\n  Asunto: origen.subject,\n  Categoria: datos.categoria,\n  Urgencia: datos.urgencia,\n  Resumen: datos.resumen,\n  Empresa: datos.empresa || '',\n  Monto: typeof datos.monto === 'number' ? datos.monto : null,\n  Accion_sugerida: datos.accion_sugerida || ''\n}};"
      },

    {
      "parameters": {
        "jsCode": " const r = $json;\nconst origen = $('Edit Fields').item.json;\n\nlet datos;\ntry {\n  const txt = r.candidates[0].content.parts.map(p => p.text || '').join('')\n    .replace(/```json|```/g, '').trim();\n  datos = JSON.parse(txt);\n  if (!datos.categoria || !datos.urgencia) throw new Error('faltan campos');\n} catch (e) {\n  datos = { categoria: 'otro', urgencia: 'media', resumen: 'ERROR DE FORMATO - revisar', monto: null };\n}\n\n// En \"Edit Fields\" los campos se llaman Date y Subject (con mayúscula inicial)\nconst f = new Date(origen.Date || origen.date);\n\nfunction capitalizar(s) {\n  if (!s) return s;\n  s = String(s).trim();\n  return s.charAt(0).toUpperCase() + s.slice(1).toLowerCase();\n}\n\nreturn { json: {\n  ID_Mensaje: origen.id,\n  Fecha: isNaN(f) ? null : f.toISOString(),\n  Remitente: origen.From,\n  Asunto: origen.Subject || origen.subject || '',\n  Categoria: capitalizar(datos.categoria),\n  Urgencia: String(datos.urgencia || '').trim().toLowerCase(),\n  Resumen: datos.resumen,\n  Empresa: datos.empresa || '',\n  Monto: typeof datos.monto === 'number' ? datos.monto : null,\n  Accion_sugerida: datos.accion_sugerida || ''\n}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        -64

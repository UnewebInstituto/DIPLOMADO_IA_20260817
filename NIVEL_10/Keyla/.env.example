# Copie a .env y ajuste. Todas las variables son opcionales (ver config.py).

# --- Generación ---
LLM_PROVEEDOR=ollama
OLLAMA_MODELO=llama3
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=8192
# LLM_PROVEEDOR=gemini
# GEMINI_API_KEY=su_clave
# GEMINI_MODELO=gemini-3.5-flash-lite

# --- Embeddings y recuperación ---
EMB_MODELO=intfloat/multilingual-e5-small
# EMB_MODELO=paraphrase-multilingual-MiniLM-L12-v2   # modelo del curso (trunca a 128 tokens)
CHUNK_TAMANO=800
CHUNK_SOLAPE=120
MODO=hibrida
USAR_RERANKER=1
RERANK_MODELO=BAAI/bge-reranker-v2-m3
